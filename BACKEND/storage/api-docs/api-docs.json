                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer",
                                                        "example": 1
                                                    },
                                                    "country_name": {
                                                        "type": "string",
                                                        "example": "Country Name"
                                                    },
                                                    "country_code": {
                                                        "type": "string",
                                                        "example": "US"
                                                    },
                                                    "iso_code": {
                                                        "type": "string",
                                                        "example": "US"
                                                    },
                                                    "status": {
                                                        "type": "string",
                                                        "example": "active"
                                                    }
