APP_NAME=Laravel
APP_ENV=production
# Base64-encoded app key generated via: php artisan key:generate --show
APP_KEY=base64:YOUR_APP_KEY_HERE
APP_DEBUG=false
# Keep UTC in backend unless business logic requires local TZ handling.
APP_TIMEZONE=UTC
# Used for CSV export/import timestamp formatting.
APP_CSVTIMEZONE=Asia/Kolkata
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# LOG_CHANNEL can be single/daily/stack based on deployment policy.
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Number of days to retain daily logs.
LOG_DAILY_DAYS=2

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=omnichannel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
BROADCAST_DRIVER=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_DRIVER=database
CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

JWT_SECRET=YOUR_JWT_SECRET_HERE
JWT_BLACKLIST_ENABLED=true

# If true, Swagger docs regenerate on each request in local/dev.
L5_SWAGGER_GENERATE_ALWAYS=true

REVERB_APP_ID=YOUR_REVERB_APP_ID
REVERB_APP_KEY=YOUR_REVERB_APP_KEY
REVERB_APP_SECRET=YOUR_REVERB_APP_SECRET
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Chat360 integration (required only if Chat360 features are enabled)
CHAT_360_URL="https://app.chat360.io/"
CHAT_360_EMAIL="your-email@example.com"
CHAT_360_PASSWORD="your-chat360-password"
CHAT_360_API_KEY=YOUR_CHAT360_API_KEY
CHAT_FROM_PHONE="919999999999"

# Internal chatbot service endpoint
CHATBOT_URL="http://your-chatbot-service-host:8000"

# External API integration using multiple endpoints.
# Use numbered variables (EXTERNAL_API_URL_1 / EXTERNAL_API_KEY_1, EXTERNAL_API_URL_2 / EXTERNAL_API_KEY_2, etc.)
# when calling multiple production endpoints. In that case, do not define EXTERNAL_API_URL / EXTERNAL_API_KEY.
EXTERNAL_API_URL_1=http://your-external-api-host-1/api/v1/request
EXTERNAL_API_KEY_1=YOUR_URL_ENCODED_EXTERNAL_API_KEY_1
EXTERNAL_API_URL_2=http://your-external-api-host-2/api/v1/request
EXTERNAL_API_KEY_2=YOUR_URL_ENCODED_EXTERNAL_API_KEY_2

# Retry and timeout controls for outbound API calls
RETRY_ATTEMPTS=3
# Milliseconds between retries
RETRY_WAIT=500
# Timeout for outbound API calls in seconds
TIMEOUT=360
# Max API calls allowed per minute
API_LIMIT=120

# 1 for multi-tenant hosted system, 0 for single tenant
IS_DC_MULTITENANT=0
# Required only when IS_DC_MULTITENANT=1
HOSTED_URL=http://localhost:8080
# Required only when IS_DC_MULTITENANT=1
TENANT_AUTH_USER="admin"
# Required only when IS_DC_MULTITENANT=1
TENANT_AUTH_PASS="your-tenant-auth-password"

# Enables field-level API behavior; verify exact feature scope
FIELD_API_ENABLED=false
